PORT=3698
NODE_ENV=development
GOOGLE_TTS_API=https://translate.google.com/translate_tts
REQUEST_TIMEOUT=30000
RATE_LIMIT=100
RATE_LIMIT_WINDOW=900
MAX_QUEUE_LENGTH=100
MAX_QUEUE_PER_CLIENT=5
MAX_UPLOAD_AUDIO_SIZE_MB=20
MAX_UPLOAD_STORAGE_MB=500
UPLOAD_RATE_LIMIT=30
UPLOAD_RATE_WINDOW=60
ADMIN_TOKEN=change-this-admin-token
SOCKET_AUTH_TOKEN=
SOCKET_PING_TIMEOUT=20000
SOCKET_PING_INTERVAL=25000
CLIENT_SESSION_TTL_SECONDS=86400
SESSION_COOKIE_SECURE=true
ALLOWED_ORIGINS=http://localhost:3698,http://127.0.0.1:3698
